{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "MovSeg (Web + Backend)",
			"dependsOn": ["MovSeg Web Dev Server", "MovSeg Backend"],
			"problemMatcher": []
		},
		{
			"label": "MovSeg Web Dev Server",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"web",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "MovSeg Backend",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": ["bootRun"],
			"options": {
				"cwd": "${workspaceFolder}/backend",
				"env": {
					"DB_URL": "jdbc:postgresql://localhost:5433/movseg"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
